<?xml version="1.0" encoding="utf-8"?>
<layout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools">

    <androidx.core.widget.NestedScrollView
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:background="@color/backgroundColor"
        android:fillViewport="true">

        <androidx.constraintlayout.widget.ConstraintLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content" >

            <androidx.appcompat.widget.LinearLayoutCompat
                android:id="@+id/llContainer"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                app:layout_constraintTop_toTopOf="parent"
                android:orientation="vertical"
                android:layout_marginHorizontal="@dimen/_12sdp"
                android:focusableInTouchMode="true"
                android:focusable="true">

                <androidx.constraintlayout.widget.ConstraintLayout
                    android:id="@+id/clUserInfo"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:paddingVertical="@dimen/_4sdp"
                    android:layout_marginTop="@dimen/_16sdp">

                    <com.google.android.material.imageview.ShapeableImageView
                        android:id="@+id/imgProfilePic"
                        android:layout_width="@dimen/_36sdp"
                        android:layout_height="@dimen/_36sdp"
                        android:scaleType="centerCrop"
                        app:shapeAppearance="@style/RoundedImageViewShape"
                        app:strokeWidth="0dp"
                        tools:src="@tools:sample/avatars"
                        app:layout_constraintStart_toStartOf="parent"
                        app:layout_constraintTop_toTopOf="parent"/>

                    <androidx.appcompat.widget.AppCompatTextView
                        android:id="@+id/tvUserName"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:textColor="@color/text_color"
                        android:textSize="@dimen/_12ssp"
                        android:layout_marginHorizontal="@dimen/_8sdp"
                        app:layout_constraintBottom_toBottomOf="@id/imgProfilePic"
                        app:layout_constraintEnd_toEndOf="parent"
                        app:layout_constraintStart_toEndOf="@id/imgProfilePic"
                        app:layout_constraintTop_toTopOf="@id/imgProfilePic"
                        tools:text="User Name" />


                </androidx.constraintlayout.widget.ConstraintLayout>


                <androidx.constraintlayout.widget.ConstraintLayout
                    android:id="@+id/clAudioItemPreview"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/_16sdp"
                    android:paddingVertical="@dimen/_8sdp">


                    <com.google.android.material.card.MaterialCardView
                        android:id="@+id/cvCoverPreview"
                        android:layout_width="@dimen/_36sdp"
                        android:layout_height="@dimen/_36sdp"
                        app:layout_constraintBottom_toBottomOf="parent"
                        app:layout_constraintStart_toStartOf="parent"
                        app:layout_constraintTop_toTopOf="parent"
                        app:strokeWidth="0dp">

                        <androidx.appcompat.widget.AppCompatImageView
                            android:id="@+id/audioIcon"
                            android:layout_width="match_parent"
                            android:layout_height="match_parent"
                            android:layout_gravity="center"
                            android:src="@drawable/ic_music_new" />

                        <com.airbnb.lottie.LottieAnimationView
                            android:id="@+id/lottiePlayingAnim"
                            android:layout_width="match_parent"
                            android:layout_height="match_parent"
                            android:visibility="gone"
                            app:lottie_cacheComposition="true" />

                    </com.google.android.material.card.MaterialCardView>

                    <androidx.appcompat.widget.AppCompatTextView
                        android:id="@+id/tvAudioTitle"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_marginHorizontal="@dimen/_8sdp"
                        android:ellipsize="end"
                        android:maxLines="2"
                        android:textColor="@color/text_color"
                        android:textSize="@dimen/_14ssp"
                        android:textStyle="bold"
                        app:layout_constraintBottom_toTopOf="@+id/linearLayoutCompat2"
                        app:layout_constraintEnd_toStartOf="@+id/imgPlayPause"
                        app:layout_constraintHorizontal_bias="0.5"
                        app:layout_constraintStart_toEndOf="@+id/cvCoverPreview"
                        app:layout_constraintTop_toTopOf="parent"
                        app:layout_constraintVertical_chainStyle="packed"
                        tools:text="Music Title" />

                    <androidx.appcompat.widget.LinearLayoutCompat
                        android:id="@+id/linearLayoutCompat2"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_marginHorizontal="@dimen/_8sdp"
                        app:layout_constraintBottom_toBottomOf="parent"
                        app:layout_constraintEnd_toStartOf="@id/imgPlayPause"
                        app:layout_constraintHorizontal_bias="0.5"
                        app:layout_constraintStart_toEndOf="@+id/cvCoverPreview"
                        app:layout_constraintTop_toBottomOf="@+id/tvAudioTitle">

                        <TextView
                            android:id="@+id/tvAuthorName"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:ellipsize="end"
                            android:maxLines="1"
                            android:textColor="@color/text_color"
                            android:textSize="@dimen/_10ssp"
                            tools:text="Author Name" />

                        <TextView
                            android:id="@+id/tvHyphon"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text=" - "
                            android:textColor="@color/text_color"
                            android:textSize="@dimen/_12ssp" />

                        <TextView
                            android:id="@+id/tvAudioDuration"
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:textColor="@color/text_color"
                            android:textSize="@dimen/_10ssp"
                            tools:text="0.38s" />

                    </androidx.appcompat.widget.LinearLayoutCompat>

                    <com.google.android.material.imageview.ShapeableImageView
                        android:id="@+id/imgPlayPause"
                        android:layout_width="@dimen/_28sdp"
                        android:layout_height="@dimen/_28sdp"
                        app:layout_constraintBottom_toBottomOf="parent"
                        app:layout_constraintEnd_toEndOf="parent"
                        app:layout_constraintTop_toTopOf="parent"
                        app:srcCompat="@drawable/ic_play_circle_outline"
                        app:tint="@color/colorOnBackground" />


                    <ProgressBar
                        android:id="@+id/progressBarPlayPause"
                        android:layout_width="32dp"
                        android:layout_height="32dp"
                        android:layout_marginEnd="@dimen/_4sdp"
                        android:indeterminate="true"
                        android:indeterminateTint="@color/colorOnBackground"
                        android:visibility="gone"
                        app:layout_constraintBottom_toBottomOf="parent"
                        app:layout_constraintEnd_toEndOf="parent"
                        app:layout_constraintTop_toTopOf="parent"
                        app:tint="@color/colorOnBackground" />

                </androidx.constraintlayout.widget.ConstraintLayout>


                <androidx.appcompat.widget.LinearLayoutCompat
                    android:id="@+id/llMusicTitle"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:layout_marginTop="@dimen/_24sdp">

                    <TextView
                        android:id="@+id/tvLabelMusicTitle"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:text="@string/music_title"
                        android:textColor="@color/text_color"
                        android:textSize="@dimen/_14ssp" />


                    <com.google.android.material.textfield.TextInputLayout
                        android:id="@+id/textInputLayoutMusicTitle"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:background="@drawable/bg_curved_dark"
                        android:paddingHorizontal="@dimen/_16sdp"
                        android:paddingVertical="@dimen/_8sdp"
                        android:backgroundTint="@color/grey1000"
                        android:layout_marginTop="@dimen/_4sdp"
                        android:theme="@style/ThemeOverlay.AppTheme.TextInputEditText.Outlined"
                        app:boxStrokeColor="@color/grey250">

                        <androidx.appcompat.widget.AppCompatEditText
                            android:id="@+id/etMusicTitle"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:textCursorDrawable="@drawable/edit_text_cursor_drawable_color_accent"
                            android:hint="@string/enter_music_title"
                            android:inputType="textPersonName|textCapSentences"
                            android:maxLength="25"
                            android:maxLines="2"
                            android:textSize="@dimen/_12ssp"
                            android:textColor="@color/colorOnBackground"
                            android:textColorHint="@color/grey400" />

                    </com.google.android.material.textfield.TextInputLayout>

                </androidx.appcompat.widget.LinearLayoutCompat>


                <androidx.constraintlayout.widget.ConstraintLayout
                    android:id="@+id/llMusicCover"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:layout_marginTop="@dimen/_24sdp">

                    <TextView
                        android:id="@+id/tvLabelMusicCover"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:text="@string/music_cover"
                        android:textColor="@color/text_color"
                        android:textSize="@dimen/_14ssp"
                        app:layout_constraintTop_toTopOf="parent"/>


                    <com.google.android.material.card.MaterialCardView
                        android:id="@+id/cvCustomCover"
                        android:layout_width="@dimen/_108sdp"
                        android:layout_height="@dimen/_108sdp"
                        android:layout_marginTop="@dimen/_8sdp"
                        app:layout_constraintDimensionRatio="1:1"
                        app:layout_constraintStart_toStartOf="parent"
                        app:layout_constraintTop_toBottomOf="@id/tvLabelMusicCover"
                        app:strokeWidth="0dp">

                        <androidx.appcompat.widget.AppCompatImageView
                            android:id="@+id/imgCustomCover"
                            android:layout_width="match_parent"
                            android:layout_height="match_parent"
                            android:layout_gravity="center"
                            android:src="@drawable/ic_add_image" />

                    </com.google.android.material.card.MaterialCardView>


                </androidx.constraintlayout.widget.ConstraintLayout>


                <androidx.appcompat.widget.AppCompatButton
                    android:id="@+id/btnUpload"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/_24sdp"
                    android:gravity="center"
                    android:paddingVertical="@dimen/_6sdp"
                    android:text="@string/upload_music"
                    android:textSize="@dimen/_12ssp"
                    android:textColor="@color/backgroundColor"
                    android:textStyle="bold"
                    android:background="@drawable/bg_curved_dark_15sdp"
                    android:backgroundTint="@color/button_background_color"
                    android:enabled="false"
                    app:layout_constraintBottom_toBottomOf="parent"
                    app:layout_constraintEnd_toEndOf="parent"
                    app:layout_constraintStart_toStartOf="parent"
                    app:layout_constraintTop_toBottomOf="@+id/errorTitleTextView" />


            </androidx.appcompat.widget.LinearLayoutCompat>

            <include
                android:id="@+id/errorLayout"
                layout="@layout/error_layout_common"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:layout_marginHorizontal="@dimen/_32sdp"
                android:visibility="gone" />

        </androidx.constraintlayout.widget.ConstraintLayout>



    </androidx.core.widget.NestedScrollView>
</layout>