<?xml version="1.0" encoding="utf-8"?>
<layout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools">

    <androidx.appcompat.widget.LinearLayoutCompat
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:paddingHorizontal="@dimen/_16sdp"
        android:paddingVertical="@dimen/_12sdp"
        android:focusableInTouchMode="true"
        android:focusable="true"
        android:background="@color/backgroundColor">

        <androidx.appcompat.widget.LinearLayoutCompat
            android:id="@+id/layoutPickMusic"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:background="@drawable/bg_rectangle_dash_outline"
            android:padding="@dimen/_16sdp">

            <androidx.appcompat.widget.AppCompatImageView
                android:layout_width="@dimen/_48sdp"
                android:layout_height="@dimen/_48sdp"
                android:layout_gravity="center_horizontal"
                app:srcCompat="@drawable/ic_play_circle_outline"
                app:tint="@color/colorOnBackground"
                android:layout_marginTop="@dimen/_8sdp" />


            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/browse_music_file"
                android:textColor="@color/colorOnBackground"
                android:layout_gravity="center_horizontal"
                android:textSize="@dimen/_12ssp"
                android:textAlignment="center"
                android:layout_marginTop="@dimen/_8sdp"/>

        </androidx.appcompat.widget.LinearLayoutCompat>


        <androidx.appcompat.widget.AppCompatButton
            android:id="@+id/btnBrowseMusicFile"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/upload_music"
            android:textColor="@color/backgroundColor"
            android:textSize="@dimen/_12ssp"
            android:gravity="center"
            android:paddingLeft="@dimen/_12sdp"
            android:paddingRight="@dimen/_16sdp"
            android:paddingVertical="@dimen/_6sdp"
            android:background="@drawable/bg_curved_dark_15sdp"
            android:backgroundTint="@color/colorAccent"
            android:layout_gravity="center_horizontal"
            android:drawableLeft="@drawable/ic_add"
            android:drawablePadding="@dimen/_4sdp"
            android:layout_marginTop="@dimen/_8sdp" />


    </androidx.appcompat.widget.LinearLayoutCompat>
</layout>