<?xml version="1.0" encoding="utf-8"?>
<layout xmlns:tools="http://schemas.android.com/tools"
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto">
    <com.google.android.material.card.MaterialCardView
        android:id="@+id/cvRoot"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        app:cardBackgroundColor="@color/transparent"
        tools:background="@color/backgroundColor"
        app:strokeWidth="0dp"
        app:cardElevation="0dp"
        app:cardCornerRadius="@dimen/_5sdp">

        <androidx.constraintlayout.widget.ConstraintLayout
            android:id="@+id/clRoot"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:padding="16dp">

            <com.google.android.material.card.MaterialCardView
                android:id="@+id/cvCover"
                android:layout_width="@dimen/_36sdp"
                android:layout_height="@dimen/_36sdp"
                android:backgroundTint="@color/backgroundColor"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toTopOf="parent"
                app:strokeWidth="0dp">

                <androidx.appcompat.widget.AppCompatImageView
                    android:id="@+id/audioIcon"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:layout_gravity="center"
                    android:src="@drawable/ic_music_card"/>

                <com.airbnb.lottie.LottieAnimationView
                    android:id="@+id/lottiePlayingAnim"
                    android:visibility="gone"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    app:lottie_cacheComposition="true" />

            </com.google.android.material.card.MaterialCardView>

            <TextView
                android:id="@+id/tvAudioTitle"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginHorizontal="@dimen/_8sdp"
                android:maxLines="1"
                android:ellipsize="end"
                android:textSize="@dimen/_12ssp"
                android:textColor="@color/colorOnBackground"
                android:textStyle="bold"
                app:layout_constraintEnd_toStartOf="@+id/imgPlayPause"
                app:layout_constraintStart_toEndOf="@+id/cvCover"
                app:layout_constraintTop_toTopOf="@+id/cvCover"
                tools:text="Audio Name" />

            <androidx.appcompat.widget.LinearLayoutCompat
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                app:layout_constraintStart_toEndOf="@+id/cvCover"
                app:layout_constraintTop_toBottomOf="@id/tvAudioTitle"
                app:layout_constraintEnd_toStartOf="@id/imgPlayPause"
                android:layout_marginHorizontal="@dimen/_8sdp">

                <TextView
                    android:id="@+id/tvAuthorName"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:ellipsize="end"
                    android:maxLines="1"
                    android:textColor="@color/grey400"
                    android:textSize="@dimen/_10ssp"
                    tools:text="Author Name" />

                <TextView
                    android:id="@+id/tvHyphon"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:textColor="@color/grey400"
                    android:textSize="@dimen/_12ssp"
                    android:text=" - " />

                <TextView
                    android:id="@+id/tvAudioDuration"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:textColor="@color/grey400"
                    android:textSize="@dimen/_10ssp"
                    tools:text="0.38s" />

            </androidx.appcompat.widget.LinearLayoutCompat>

            <com.google.android.material.imageview.ShapeableImageView
                android:id="@+id/imgPlayPause"
                android:layout_width="@dimen/_28sdp"
                android:layout_height="@dimen/_28sdp"
                app:layout_constraintBottom_toBottomOf="parent"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintTop_toTopOf="parent"
                app:srcCompat="@drawable/ic_play_circle_outline"
                app:tint="@color/colorOnBackground" />

            <ProgressBar
                android:id="@+id/progressBar"
                android:layout_width="32dp"
                android:layout_height="32dp"
                android:visibility="gone"
                android:layout_marginEnd="@dimen/_4sdp"
                android:indeterminate="true"
                android:indeterminateTint="@color/colorOnBackground"
                app:layout_constraintBottom_toBottomOf="parent"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintTop_toTopOf="parent"
                app:tint="@color/colorOnBackground" />

        </androidx.constraintlayout.widget.ConstraintLayout>

    </com.google.android.material.card.MaterialCardView>

</layout>